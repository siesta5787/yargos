# Architecture
BR2_x86_64=y
BR2_x86_corei7=y

# Faster rebuilds after a clean (cache lives in ~/.buildroot-ccache)
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=20G"

# Toolchain: YARG (Unity/Mono) needs glibc
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_MERGED_USR=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_HOSTNAME="yargos"
BR2_TARGET_GENERIC_ISSUE="YARGOS"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_YARGOS_PATH)/board/yargos/users.table"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_YARGOS_PATH)/board/yargos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_YARGOS_PATH)/board/yargos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_YARGOS_PATH)/board/yargos/post-image.sh"
BR2_PACKAGE_SYSTEMD_BOOT=y
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_ACL=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_YARGOS_PATH)/board/yargos/linux.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Firmware: broad coverage so the image works on other AMD/Intel hardware
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
