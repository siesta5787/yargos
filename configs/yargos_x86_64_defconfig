BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXI=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXXF86VM=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_VULKAN_LOADER=y

# Input: hidapi/libusb are dlopen'd by YARG's HIDrogen plugin
BR2_PACKAGE_HIDAPI=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_LIBINPUT=y

# Audio: ALSA direct (BASS and Unity both speak ALSA)
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_PLUGINS=y
BR2_PACKAGE_LIBSAMPLERATE=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIDI=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Bluetooth / WiFi
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# Bluetooth headphones/earbuds as a sound output: A2DP (SBC) through an ALSA plugin, no sound server
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ_ALSA=y
BR2_PACKAGE_IWD=y
BR2_PACKAGE_WIRELESS_REGDB=y

# Storage / utilities
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
# The `openssl` command: the updater verifies the release signature (Ed25519) with it.
BR2_PACKAGE_LIBOPENSSL_BIN=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIBCURL_CURL=y

# Debug tools (move to a separate fragment for release images)
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_LINUXCONSOLETOOLS=y
BR2_PACKAGE_LINUXCONSOLETOOLS_JOYSTICK=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_MESA3D_DEMOS=y
BR2_PACKAGE_VULKAN_TOOLS=y

# YARGOS packages
# YARG itself is not in the image: it is downloaded on the device (and its release bundles proprietary parts that
# must not be redistributed). `YARGOS_WITH_YARG=1 tools/br.sh` makes a private test image that has it preloaded.
# BR2_PACKAGE_YARG is not set
BR2_PACKAGE_YARGOS_BRIDGE=y
BR2_PACKAGE_YARGOS_HOME=y

# Images
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="1500M"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
