# Generated by post-image.sh (the ESP file list depends on the version). Layout:
#   ESP 256M | system A (2G, holds the shipped system) | system B (2G, empty: the first update goes here) | data
image efi-part.vfat {
	vfat {
@ESP_FILES@
	}
	size = 256M
}

image data.ext4 {
	ext4 {
		label = "YARGDATA"
		use-mke2fs = true
	}
	size = 700M
}

image yargos.img {
	hdimage {
		partition-table-type = "gpt"
	}

	partition boot {
		image = "efi-part.vfat"
		partition-type-uuid = U
		offset = 1M
		bootable = true
	}

	partition yargos-a {
		image = "rootfs.ext4"
		partition-type-uuid = L
		partition-uuid = 6d5a1c52-0d4e-4c5b-9a3f-7e3b8a1f0001
		size = 2G
	}

	partition yargos-b {
		partition-type-uuid = L
		partition-uuid = 6d5a1c52-0d4e-4c5b-9a3f-7e3b8a1f0003
		size = 2G
	}

	partition data {
		image = "data.ext4"
		partition-type-uuid = L
		partition-uuid = 6d5a1c52-0d4e-4c5b-9a3f-7e3b8a1f0002
	}
}
