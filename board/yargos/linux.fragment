# Boot / filesystems
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# Graphics (AMD primary, Intel/Nvidia for portability)
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
# Hand the firmware's (UEFI GOP) screen to simpledrm so something is visible from the first kernel message
# until the real GPU driver loads. Without this a real PC shows nothing if that driver is late or fails.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FB=y
# Creates /dev/fb0 on top of any DRM driver: the boot splash and the on-screen console need it.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Audio: USB audio/MIDI, HDMI/DP audio, and the ALSA sequencer
# (libRtMidi in YARG needs it to enumerate MIDI ports).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SEQUENCER=y
CONFIG_SND_SEQ_DUMMY=m
CONFIG_SND_RAWMIDI=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=m
CONFIG_SND_USB_AUDIO_MIDI_V2=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_AMD_ACP=m

# Input: raw HID access for instruments, virtual HID for the Wiimote bridge
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_UHID=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
# Laptop touchpads and wireless mouse receivers. Touchpads on AMD laptops are I2C-HID devices behind the
# AMD GPIO/pin controller and a DesignWare I2C controller; without these there is no pointer at all.
# X86_AMD_PLATFORM_DEVICE turns the AMD ACPI I2C controllers into platform devices (and pulls in COMMON_CLK,
# which the DesignWare platform driver depends on); without it the driver is silently dropped.
CONFIG_X86_AMD_PLATFORM_DEVICE=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_HID_MULTITOUCH=y
# Logitech and PlayStation HID drivers depend on the LED class (multicolor for the light bars).
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_APPLE=y
CONFIG_HID_ALPS=y
CONFIG_HID_RMI=y
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
# hid-wiimote is intentionally absent: yargos-bridge needs the raw reports.
# CONFIG_HID_WIIMOTE is not set

# FUSE: ntfs-3g mounts Windows (NTFS) song drives; the kernel's own ntfs3 refuses drives Windows left
# slightly untidy, ntfs-3g reads them. exFAT, FAT and ext4 are built in.
CONFIG_FUSE_FS=y

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y

# Bluetooth (classic + LE HID, HOGP via bluez/uhid)
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_INTEL=m
CONFIG_BT_RTL=m
CONFIG_BT_MTK=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART=m
CONFIG_RFKILL=y

# Wireless and wired networking
# Modules so regulatory.db loads after the root filesystem is mounted (built in, it is looked for too early).
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_RTW88=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
# USB WiFi adapters: Realtek (rtl8xxxu/rtw88/rtw89), MediaTek, Ralink, Atheros
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_WLAN_VENDOR_ZYDAS=y
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL8187=m
CONFIG_RTLWIFI=m
CONFIG_RTL8192CU=m
CONFIG_RTW88_USB=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8822CU=m
CONFIG_RTW88_8723DU=m
CONFIG_RTW89_8851BE=m
CONFIG_MT76_CORE=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_MT7601U=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_ATH10K_USB=m
# Loopback radios, to test iwd and the crypto it needs without a real adapter
CONFIG_MAC80211_HWSIM=m
CONFIG_R8169=m
CONFIG_IGC=m
CONFIG_E1000E=m

# What iwd needs from the kernel (AF_ALG and keyring crypto for the WPA handshakes)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

# Firmware loading from rootfs
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Cleanups
# CONFIG_DEBUG_INFO is not set
# Modules stay uncompressed: the build's depmod has no zlib/xz/zstd, so it would index none of them.
