# <file system>        <mount pt>    <type>  <options>                                         <dump> <pass>
# /data is not here: the boot entry names it (systemd.mount-extra), so this file is the same on every disk.
# Automount: no boot-time wait if the drive is absent, and a drive plugged in later just works.
LABEL=YARGSONGS        /media/songs  auto    ro,noatime,nofail,noauto,x-systemd.automount,x-systemd.device-timeout=3s  0  0
tmpfs                  /tmp          tmpfs   mode=1777,nosuid,nodev                            0      0
