# One bridge per Wiimote (057E:0306 original, 057E:0330 Wii Remote Plus), via raw hidraw.
ACTION=="add", SUBSYSTEM=="hidraw", KERNELS=="0005:0000057E:0306.*|0005:0000057E:0330.*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="yargos-bridge-wii@%k.service"

# Wired Xbox 360 drum kits, read through the kernel's xpad evdev node.
# 1bad:0130 = ION Drum Rocker
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{id/vendor}=="1bad", ATTRS{id/product}=="0130", TAG+="systemd", ENV{SYSTEMD_WANTS}+="yargos-bridge-drums@%k.service"
