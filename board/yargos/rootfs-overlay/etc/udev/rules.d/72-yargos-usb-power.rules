# No USB autosuspend (this is a mains-powered console): a wireless-keyboard receiver that went to sleep did not always wake
# on a key press after it was plugged back in, so the keyboard stayed dead until a reboot. Hubs are left alone.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{bDeviceClass}!="09", TEST=="power/control", ATTR{power/control}="on"

# A wireless-keyboard receiver plugged in while running can stay silent: usb-kick watches it and re-enumerates it until
# keys arrive (24ae = the receiver this was found with; and any USB device with a boot keyboard interface 03/01/01).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="24ae", TAG+="systemd", ENV{SYSTEMD_WANTS}+="yargos-usb-kick@%k.service"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{ID_USB_INTERFACES}=="*:030101:*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="yargos-usb-kick@%k.service"
