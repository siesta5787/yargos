[Unit]
Description=Grow the YARGOS data partition to fill the drive
DefaultDependencies=no
# Not tied to one device unit: the data partition is named by label on the flashed image and by GUID after
# an install, so the script waits for it itself once udev has seen the drives.
After=local-fs-pre.target systemd-udevd.service systemd-udev-trigger.service
Wants=systemd-udev-trigger.service
# Rewriting the partition table makes the device disappear for a moment: finish before /data is mounted.
Before=data.mount local-fs.target yargos-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/lib/yargos/growdata.sh
# A failure here must never stop the machine from booting.
SuccessExitStatus=0 1

[Install]
WantedBy=local-fs.target
