[Unit]
Description=Wiimote guitar bridge for %I
# Tied to the Wiimote's hidraw device: stopped when it disconnects, and restarted if it fails while the Wiimote is
# still there (a connected Wiimote should always end up with a running bridge).
BindsTo=dev-%i.device
After=dev-%i.device
# No start limit: a bridge that gave up for good ("start request repeated too quickly") would leave a connected
# Wiimote dead until the next reboot. BindsTo already ends it when the Wiimote goes away.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/yargos-bridge wii /dev/%I
Restart=on-failure
RestartSec=2
User=root
