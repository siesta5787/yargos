[Unit]
Description=YARG
After=yargos-firstboot.service systemd-user-sessions.service systemd-logind.service
Wants=yargos-firstboot.service
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=player
PAMName=yarg
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=HOME=/data/home/player XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/lib/yargos/session.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
