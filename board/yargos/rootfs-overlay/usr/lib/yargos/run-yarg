#!/bin/sh
xset s off -dpms
# Unity's built-in SDL sees no window manager and falls back to "legacy" fullscreen: it reparents its window
# into an override-redirect container, which drops the X focus the session gave it. SDL then thinks the game
# is in the background and swallows every key and click. The non-legacy path keeps the window top-level
# (it is already screen-sized) so the focus sticks.
export SDL_VIDEO_X11_LEGACY_FULLSCREEN=0

# The song drive (any drive labelled YARGSONGS) mounts at /media/songs, and songs imported to the internal drive live in
# /data/songs (SYSTEM > Storage). Every top-level folder of either that has songs becomes its own song source in YARG
# (song-sources decides), so nobody adds folders by hand. Sources YARG already has outside those two places are kept; the
# ones under them are replaced by what is there now. With no song drive connected its entries are left alone, unless
# there are internal songs (the list is then rebuilt); entries for internal folders that are gone are dropped.
# AUTO_SONG_SOURCES=no in /data/yargos.conf turns this off.
SETTINGS=/data/yarg/settings.json
AUTO_SONG_SOURCES=yes
[ -f /data/yargos.conf ] && grep -qx 'AUTO_SONG_SOURCES=no' /data/yargos.conf && AUTO_SONG_SOURCES=no
if [ "$AUTO_SONG_SOURCES" != no ]; then
    SOURCES=$(/usr/lib/yargos/song-sources)
    NEW=$(printf '%s\n' "$SOURCES" | jq -R . | jq -s 'map(select(. != ""))')
    if [ -n "$SOURCES" ]; then
        if [ ! -f "$SETTINGS" ]; then
            printf '{"SongFolders":%s}\n' "$NEW" > "$SETTINGS"
        elif jq -e . "$SETTINGS" >/dev/null 2>&1; then
            jq --argjson new "$NEW" '.SongFolders = (((.SongFolders // []) | map(select((startswith("/media/songs") or startswith("/data/songs")) | not))) + $new)' \
                "$SETTINGS" > "$SETTINGS.new" && mv "$SETTINGS.new" "$SETTINGS"
        fi
    elif [ -f "$SETTINGS" ] && jq -e . "$SETTINGS" >/dev/null 2>&1; then
        jq '.SongFolders = ((.SongFolders // []) | map(select(startswith("/data/songs") | not)))' \
            "$SETTINGS" > "$SETTINGS.new" && mv "$SETTINGS.new" "$SETTINGS"
    fi
fi
# YARG shows its clock (Settings > Show time) with the culture's short time pattern, "{0:t}". Mono takes the culture from LC_ALL / LANG, and
# with neither set that is the invariant culture, whose short time is 24-hour ("21:41") whatever SYSTEM > Date & time says. So the
# clock setting is passed on: en-US writes "9:41 PM", en-GB "21:41". (Numbers and dates are formatted the same way in both.)
unset LC_ALL
if [ -f /data/yargos.conf ] && grep -qx 'CLOCK24=yes' /data/yargos.conf; then export LANG=en_GB.UTF-8; else export LANG=en_US.UTF-8; fi
# YARG's audio library (BASS) loads its add-ons (Opus decoding, the effects used for the microphone) by bare
# name, which only works if the plugins folder is on the library path. Without it every .opus sound effect,
# every Opus song and the microphone silently fail ("Failed to load ...: OK!", "Failed to initialize microphone").
export LD_LIBRARY_PATH=/data/apps/yarg/current/YARG_Data/Plugins${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
exec /data/apps/yarg/current/YARG \
    -screen-fullscreen 1 \
    -offline \
    -persistent-data-path /data/yarg
