#!/bin/sh
xset s off -dpms
# Unity's built-in SDL sees no window manager and falls back to "legacy" fullscreen: it reparents its window
# into an override-redirect container, which drops the X focus the session gave it. SDL then thinks the game
# is in the background and swallows every key and click. The non-legacy path keeps the window top-level
# (it is already screen-sized) so the focus sticks.
export SDL_VIDEO_X11_LEGACY_FULLSCREEN=0

# The song drive (any drive labelled YARGSONGS) mounts at /media/songs. Every top-level folder on it that has songs
# becomes its own song source in YARG (song-sources decides), so nobody adds folders by hand. Sources YARG already
# has outside /media/songs are kept; the ones under /media/songs are replaced by what is on the drive now. With no
# drive connected the list is left alone. AUTO_SONG_SOURCES=no in /data/yargos.conf turns this off.
SETTINGS=/data/yarg/settings.json
AUTO_SONG_SOURCES=yes
[ -f /data/yargos.conf ] && . /data/yargos.conf
if [ "$AUTO_SONG_SOURCES" != no ]; then
    SOURCES=$(/usr/lib/yargos/song-sources)
    NEW=$(printf '%s\n' "$SOURCES" | jq -R . | jq -s 'map(select(. != ""))')
    if [ -n "$SOURCES" ]; then
        if [ ! -f "$SETTINGS" ]; then
            printf '{"SongFolders":%s}\n' "$NEW" > "$SETTINGS"
        elif jq -e . "$SETTINGS" >/dev/null 2>&1; then
            jq --argjson new "$NEW" '.SongFolders = (((.SongFolders // []) | map(select(startswith("/media/songs") | not))) + $new)' \
                "$SETTINGS" > "$SETTINGS.new" && mv "$SETTINGS.new" "$SETTINGS"
        fi
    fi
fi
# YARG's audio library (BASS) loads its add-ons (Opus decoding, the effects used for the microphone) by bare
# name, which only works if the plugins folder is on the library path. Without it every .opus sound effect,
# every Opus song and the microphone silently fail ("Failed to load ...: OK!", "Failed to initialize microphone").
export LD_LIBRARY_PATH=/data/apps/yarg/current/YARG_Data/Plugins${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
exec /data/apps/yarg/current/YARG \
    -screen-fullscreen 1 \
    -offline \
    -persistent-data-path /data/yarg
