#!/bin/sh
# song-sources: print the folders YARG should scan on the song drive, one per line (nothing if no drive is
# connected), then those of the internal song library (/data/songs, SYSTEM > Storage), one imported drive at a time.
# Each top-level folder that has songs in it becomes its own source, so a drive organised into folders
# (for sorting) shows up as separate sources in YARG. A flat drive, where the top-level folders are songs
# themselves (or there are song files at the top), is one source: the whole drive.
# A song is a folder with song.ini, notes.chart or notes.mid; a .sng file is a packed song; a Rock Band CON/LIVE file is one too.
ROOT=${YARGOS_SONGS:-/media/songs}
INTERNAL=${YARGOS_INTERNAL:-/data/songs}

has_songs() { # has_songs DIR: any song within eight levels (stops at the first). Names are matched without regard to case
    # (Windows-made drives have Song.ini and NOTES.MID); Rock Band files (CON/LIVE) have no marker file, they are told by
    # the first four bytes.
    find "$1" -maxdepth 8 \( -iname song.ini -o -iname notes.chart -o -iname notes.mid -o -iname '*.sng' \) -print 2>/dev/null | head -n 1 | grep -q . && return 0
    find "$1" -maxdepth 8 -type f \( -iname '*.con' -o -iname '*.live' -o -iname '*.rb3con' -o ! -name '*.*' \) -size +64k -print 2>/dev/null | head -n 40 |
        while IFS= read -r f; do
            case $(dd if="$f" bs=4 count=1 2>/dev/null) in 'CON ' | LIVE | PIRS) echo "$f"; break ;; esac
        done | grep -q .
}

is_song() { find "$1" -maxdepth 1 \( -iname song.ini -o -iname notes.chart -o -iname notes.mid \) -print 2>/dev/null | head -n 1 | grep -q .; }

skip() { # Windows and filesystem housekeeping folders, hidden folders
    case $1 in .* | '$'* | 'System Volume Information' | 'lost+found' | RECYCLER | 'found.'*) return 0 ;; esac
    return 1
}

scan() { # scan DIR: the sources inside one drive (or one imported drive's folder)
    root=$1
    flat=no
    for d in "$root"/*/; do
        [ -d "$d" ] || continue
        skip "$(basename "$d")" && continue
        if is_song "${d%/}"; then flat=yes; break; fi
    done
    find "$root" -maxdepth 1 -iname '*.sng' 2>/dev/null | head -n 1 | grep -q . && flat=yes
    if [ "$flat" = yes ]; then
        echo "$root"
        return
    fi
    found=no
    for d in "$root"/*/; do
        [ -d "$d" ] || continue
        name=$(basename "$d")
        skip "$name" && continue
        if has_songs "${d%/}"; then
            echo "$root/$name"
            found=yes
        fi
    done
    # Songs nowhere we could see (or deeper than eight levels): scan the whole drive rather than nothing.
    [ "$found" = yes ] || echo "$root"
}

# The song drive. Looking inside makes the automount mount it; if nothing is mounted, there is no drive.
ls "$ROOT" >/dev/null 2>&1
# The automount leaves an "autofs" entry behind even once the drive is mounted over it, so look for a real one.
if [ -n "${YARGOS_SONGS_TEST:-}" ] || awk -v r="$ROOT" '$2 == r && $3 != "autofs" { found = 1 } END { exit !found }' "${YARGOS_MOUNTS:-/proc/mounts}"; then
    scan "$ROOT"
fi

# The internal library: every folder in it is an imported drive, scanned like a drive of its own.
for d in "$INTERNAL"/*/; do
    [ -d "$d" ] || continue
    skip "$(basename "$d")" && continue
    scan "${d%/}"
done
exit 0
