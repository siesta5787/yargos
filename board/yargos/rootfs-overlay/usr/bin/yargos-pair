#!/bin/sh
# Opens a Bluetooth pairing window. Usage: yargos-pair [seconds]
# Put a Wiimote in 1+2 mode, or a wireless guitar in pairing mode, then run this.
WINDOW=${1:-60}
END=$(( $(date +%s) + WINDOW ))

bluetoothctl power on >/dev/null
bluetoothctl agent NoInputNoOutput >/dev/null
bluetoothctl default-agent >/dev/null
bluetoothctl pairable on >/dev/null
bluetoothctl --timeout "$WINDOW" scan on >/dev/null &

while [ "$(date +%s)" -lt "$END" ]; do
    for mac in $(bluetoothctl devices | awk '{print $2}'); do
        info=$(bluetoothctl info "$mac")
        case "$info" in
            *"Name: Nintendo RVL"*)
                # "Connected" only means the radio link is up; the HID link is what makes a hidraw node.
                grep -qs 'HID_ID=0005:0000057E' /sys/class/hidraw/hidraw*/device/uevent 2>/dev/null && continue
                echo "yargos-pair: Wiimote $mac found, connecting"
                bluetoothctl trust "$mac" >/dev/null
                bluetoothctl connect "$mac" | grep -E 'Connection successful|Failed' ;;
            *"Icon: input-gaming"*|*"Icon: input-keyboard"*|*"Icon: input-mouse"*)
                echo "$info" | grep -q 'Connected: yes' && continue
                bluetoothctl pair "$mac" >/dev/null
                bluetoothctl trust "$mac" >/dev/null
                bluetoothctl connect "$mac" >/dev/null ;;
        esac
    done
    sleep 2
done
echo "yargos-pair: pairing window closed"
bluetoothctl pairable off >/dev/null
